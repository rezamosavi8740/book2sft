BOOK2SFT_HOST=0.0.0.0
BOOK2SFT_PORT=8088
DATA_ROOT=/data/jobs

# Number of complete books processed at once by Book2SFT.
JOB_WORKERS=2
MAX_UPLOAD_MB=500
POLL_INTERVAL_SEC=1.0

# PDF -> OCR -> semantic chunks service.
CHUNKER_BASE_URL=http://host.docker.internal:8080
CHUNKER_TIMEOUT_SEC=7200

# Data-construction-pipeline services.
SFT_ORCHESTRATOR_BASE_URL=http://host.docker.internal:9100
SFT_GENERATOR_BASE_URL=http://host.docker.internal:9102
SFT_TIMEOUT_SEC=7200
SFT_TELEMETRY_POLL_SEC=0.8

# SFT concurrency is per book. Keep the total LLM budget in mind when JOB_WORKERS > 1.
SFT_CONCURRENCY=4
SFT_PAIR_CONCURRENCY=2
SFT_MAX_PAIRS_PER_CHUNK=3
SFT_BOOK_MAX_PAIRS=0
SFT_MAX_PER_CONCEPT=2
SFT_REQUEST_RETRIES=0
SFT_SOURCE_LANGUAGE=fa
SFT_TARGET_LANGUAGE=fa
SFT_DEFAULT_DOMAIN=general

SFT_REVIEW_PDF_SCRIPT=/app/tools/sft_jsonl_to_review_pdf_audit.py
